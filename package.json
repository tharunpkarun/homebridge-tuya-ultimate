{
  "name": "homebridge-tuya-ultimate",
  "displayName": "Tuya Ultimate",
  "version": "2.7.1",
  "description": "Tuya Smart and Smart Life integration for Homebridge with QR account authorization and live cloud updates.",
  "license": "MIT",
  "author": {
    "name": "Tharun P Karun",
    "email": "tpk@tharun.me",
    "url": "https://github.com/tharunpkarun"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tharunpkarun/homebridge-tuya-ultimate.git"
  },
  "homepage": "https://github.com/tharunpkarun/homebridge-tuya-ultimate#readme",
  "bugs": {
    "url": "https://github.com/tharunpkarun/homebridge-tuya-ultimate/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "homebridge": "^1.8.0 || ^2.0.0",
    "node": "^20 || ^22 || ^24 || ^25"
  },
  "peerDependencies": {
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**/*.ts --max-warnings=0",
    "test": "jest",
    "watch": "npm run build && npm link && nodemon",
    "launch": "tsc && homebridge -I -D",
    "build": "rimraf ./dist && tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run build && npm test -- --runInBand"
  },
  "keywords": [
    "homebridge-plugin",
    "homekit",
    "tuya"
  ],
  "dependencies": {
    "@homebridge/camera-utils": "^2.2.0",
    "@homebridge/plugin-ui-utils": "^2.2.5",
    "async-await-retry": "^2.0.1",
    "color-convert": "^2.0.1",
    "crypto-js": "^4.1.1",
    "debounce": "^1.2.1",
    "jsonschema": "^1.4.1",
    "kelvin-to-rgb": "^1.0.2",
    "lodash": "^4.18.1",
    "lodash.isequal": "^4.5.0",
    "mqtt": "^5.15.2",
    "qrcode": "^1.5.4",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/color-convert": "^2.0.0",
    "@types/crypto-js": "^4.1.1",
    "@types/debounce": "^1.2.1",
    "@types/jest": "^29.1.2",
    "@types/jsdom": "^21.1.7",
    "@types/lodash": "^4.17.24",
    "@types/lodash.isequal": "^4.5.6",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "8.57.1",
    "homebridge": "^2.0.0",
    "jest": "^29.1.2",
    "jsdom": "^26.1.0",
    "nodemon": "^3.1.10",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.3.0",
    "typescript": "^5.0.0"
  },
  "homebridge": {
    "plugin_type": "platform",
    "platform": "TuyaPlatform"
  },
  "files": [
    "dist",
    "homebridge-ui",
    "config.schema.json",
    "README.md",
    "ADVANCED_OPTIONS.md",
    "SUPPORTED_DEVICES.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ]
}
